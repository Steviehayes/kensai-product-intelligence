# Copy to .env and set ONE chat key to enable the full agentic chat.
# Leave both blank to run fully offline: TF-IDF retrieval + deterministic answers still work.
#
# Option A — Groq (free, no billing): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Option B — Google Gemini (free tier, also powers embeddings): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
PORT=7860

# Optional: set BOTH to require a username/password to open the app (HTTP Basic
# Auth). Leave unset for an open local dev instance. Used on the hosted demo.
APP_USER=
APP_PASSWORD=
