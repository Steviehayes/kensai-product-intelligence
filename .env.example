# Copy to .env and fill in to enable the full agentic chat.
# Get a free key at https://aistudio.google.com/apikey (Google AI Studio, free tier).
# Leave blank to run fully offline: TF-IDF retrieval + deterministic answers still work.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
PORT=7860

# Optional: set BOTH to require a username/password to open the app (HTTP Basic
# Auth). Leave unset for an open local dev instance. Used on the hosted demo.
APP_USER=
APP_PASSWORD=
